    {
      "id": "js-07",
      "question": "What is the average order value in dollars?",
      "category": "join fan-out trap",
      "expected_type": "scalar",
      "gold_sql": "SELECT avg(order_total) AS avg_order_value FROM (SELECT o.id, sum(p.amount) / 100.0 AS order_total FROM raw_orders o JOIN raw_payments p ON p.order_id = o.id GROUP BY o.id)",
      "tolerance": 0.01,
      "notes": "Payments must be summed per order before averaging; averaging payment rows gives the wrong answer. Orders with no payment are excluded.",
      "expected": {
        "columns": [
          "avg_order_value"
        ],
        "rows": [
          [
            16.888889
          ]
        ],
        "row_count": 1
      }
    },
