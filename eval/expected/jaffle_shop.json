    {
      "id": "js-09",
      "question": "What share of orders were returned or are pending return?",
      "category": "ratio",
      "expected_type": "scalar",
      "gold_sql": "SELECT round(100.0 * count(*) FILTER (WHERE status IN ('returned', 'return_pending')) / count(*), 2) AS returned_pct FROM raw_orders",
      "tolerance": 0.01,
      "expected": {
        "columns": [
          "returned_pct"
        ],
        "rows": [
          [
            6.06
          ]
        ],
        "row_count": 1
      }
