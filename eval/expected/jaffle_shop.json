    {
      "id": "js-03",
      "question": "What is the total amount paid in dollars, by payment method?",
      "category": "aggregation",
      "expected_type": "table",
      "gold_sql": "SELECT payment_method, sum(amount) / 100.0 AS total_dollars FROM raw_payments GROUP BY payment_method ORDER BY total_dollars DESC",
      "order_matters": true,
      "notes": "Unit trap: amount is in cents and must be divided by 100.",
      "expected": {
        "columns": [
          "payment_method",
          "total_dollars"
