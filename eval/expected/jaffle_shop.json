        "row_count": 4
      }
    },
    {
      "id": "js-04",
      "question": "Who are the top 5 customers by total amount paid?",
      "category": "multi-hop join + ranking",
      "expected_type": "table",
      "gold_sql": "SELECT c.id, c.first_name, c.last_name, sum(p.amount) / 100.0 AS total_paid FROM raw_customers c JOIN raw_orders o ON o.user_id = c.id JOIN raw_payments p ON p.order_id = o.id GROUP BY ALL ORDER BY total_paid DESC, c.id LIMIT 5",
      "order_matters": true,
      "notes": "Requires joins through non-obvious keys (user_id, order_id).",
      "expected": {
        "columns": [
          "id",
          "first_name",
          "last_name",
          "total_paid"
        ],
        "rows": [
