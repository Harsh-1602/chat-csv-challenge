    {
      "id": "js-06",
      "question": "How many customers have never placed an order?",
      "category": "anti-join",
      "expected_type": "scalar",
      "gold_sql": "SELECT count(*) AS customers_without_orders FROM raw_customers c WHERE NOT EXISTS (SELECT 1 FROM raw_orders o WHERE o.user_id = c.id)",
      "expected": {
