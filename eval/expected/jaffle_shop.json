  "questions": [
    {
      "id": "js-01",
      "question": "How many customers do we have?",
      "category": "aggregation",
      "expected_type": "scalar",
      "gold_sql": "SELECT count(*) AS customers FROM raw_customers",
      "expected": {
        "columns": [
          "customers"
        ],
        "rows": [
          [
            100
          ]
        ],
        "row_count": 1
      }
    },
    {
      "id": "js-02",
      "question": "How many orders are there in each status?",
      "category": "aggregation",
      "expected_type": "chart",
      "chart": {
        "type": "bar",
        "x": "status",
        "y": "orders"
      },
      "gold_sql": "SELECT status, count(*) AS orders FROM raw_orders GROUP BY status ORDER BY orders DESC, status",
