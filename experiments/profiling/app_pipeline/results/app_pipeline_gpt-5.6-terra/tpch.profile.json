  "semantic_model": {
    "dataset_summary": "This is a TPC-H-style commerce and supply-chain dataset covering customers, orders, order line items, parts, suppliers, supplier-part inventory/costs, and geographic nation/region dimensions. Orders belong to customers and have multiple line items; line items link to parts and suppliers, while partsupp records the supplier-specific availability and unit cost for each part. Customers and suppliers each roll up through nation to region.",
    "metrics": [
      {
        "name": "Order Count",
        "table": "orders",
        "expression": "COUNT(DISTINCT o_orderkey)",
        "description": "Number of unique orders.",
        "valid": true,
        "error": null
      },
      {
        "name": "Order Revenue",
        "table": "orders",
        "expression": "SUM(o_totalprice)",
        "description": "Total stated order value in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Average Order Value",
        "table": "orders",
        "expression": "AVG(o_totalprice)",
        "description": "Average stated total price per order in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Line Item Count",
        "table": "lineitem",
        "expression": "COUNT(*)",
        "description": "Number of order line items.",
        "valid": true,
        "error": null
      },
      {
        "name": "Ordered Quantity",
        "table": "lineitem",
        "expression": "SUM(l_quantity)",
        "description": "Total units ordered across line items.",
        "valid": true,
        "error": null
      },
      {
        "name": "Gross Merchandise Value",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice)",
        "description": "Pre-discount extended value of ordered line items in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Discount Amount",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * l_discount)",
        "description": "Total monetary discount applied to line items in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Net Line Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount))",
        "description": "Line-item revenue after discount and before tax in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Tax-Inclusive Line Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax))",
        "description": "Discounted line-item value including tax in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Available Inventory Units",
        "table": "partsupp",
        "expression": "SUM(ps_availqty)",
        "description": "Total available units across part-supplier inventory records.",
        "valid": true,
        "error": null
      }
    ],
