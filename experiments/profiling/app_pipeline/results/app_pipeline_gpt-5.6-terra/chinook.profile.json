  "semantic_model": {
    "dataset_summary": "This music-store dataset covers a catalog of artists, albums, tracks, genres, media types, and playlists, plus customers, employees, invoices, and purchased invoice lines. Sales flow from invoice headers to invoice lines and tracks; tracks roll up to albums and artists and classify by genre and media type. Customers are assigned support representatives, while playlisttrack is a bridge table between playlists and tracks.",
    "metrics": [
      {
        "name": "Total Revenue",
        "table": "invoice",
        "expression": "SUM(\"Total\")",
        "description": "Total invoiced sales in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Invoice Count",
        "table": "invoice",
        "expression": "COUNT(DISTINCT \"InvoiceId\")",
        "description": "Number of customer invoices issued.",
        "valid": true,
        "error": null
      },
      {
        "name": "Average Invoice Value",
        "table": "invoice",
        "expression": "AVG(\"Total\")",
        "description": "Average invoice total in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Distinct Purchasing Customers",
        "table": "invoice",
        "expression": "COUNT(DISTINCT \"CustomerId\")",
        "description": "Number of customers with at least one invoice.",
        "valid": true,
        "error": null
      },
      {
        "name": "Units Sold",
        "table": "invoiceline",
        "expression": "SUM(\"Quantity\")",
        "description": "Total track units purchased across invoice lines.",
        "valid": true,
        "error": null
      },
      {
        "name": "Line Item Revenue",
        "table": "invoiceline",
        "expression": "SUM(\"UnitPrice\" * \"Quantity\")",
        "description": "Revenue calculated from invoice-line prices and quantities, in USD.",
        "valid": true,
        "error": null
      },
      {
        "name": "Invoice Line Count",
        "table": "invoiceline",
        "expression": "COUNT(DISTINCT \"InvoiceLineId\")",
        "description": "Number of purchased track line items.",
        "valid": true,
        "error": null
      },
      {
        "name": "Catalog Track Count",
        "table": "track",
        "expression": "COUNT(DISTINCT \"TrackId\")",
        "description": "Number of tracks in the catalog.",
        "valid": true,
        "error": null
      },
      {
        "name": "Total Catalog Duration Hours",
        "table": "track",
        "expression": "SUM(\"Milliseconds\") / 3600000.0",
        "description": "Combined playback duration of catalog tracks, in hours.",
        "valid": true,
        "error": null
      },
      {
        "name": "Average Track Price",
        "table": "track",
        "expression": "AVG(\"UnitPrice\")",
        "description": "Average listed catalog price per track in USD.",
        "valid": true,
        "error": null
      }
    ],
