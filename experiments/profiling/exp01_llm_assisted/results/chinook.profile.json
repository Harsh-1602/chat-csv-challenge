  "semantic_model": {
    "dataset_summary": "This dataset covers a digital music store's data including artists, albums, tracks, customers, employees, invoices, and playlists. Tables are connected primarily through identifiers such as ArtistId, AlbumId, TrackId, CustomerId, and InvoiceId, enabling analysis of sales, customer behavior, and music catalog details.",
    "metrics": [
      {
        "name": "Total Revenue",
        "table": "invoice",
        "expression": "SUM(\"Total\")",
        "description": "Total revenue from all invoices in USD.",
        "valid": true
      },
      {
        "name": "Number of Customers",
        "table": "customer",
        "expression": "COUNT(DISTINCT \"CustomerId\")",
        "description": "Total number of unique customers.",
        "valid": true
      },
      {
        "name": "Number of Tracks Sold",
        "table": "invoiceline",
        "expression": "COUNT(\"InvoiceLineId\")",
        "description": "Total number of tracks sold (invoice line items).",
        "valid": true
      },
      {
        "name": "Average Track Price",
        "table": "track",
        "expression": "AVG(\"UnitPrice\")",
        "description": "Average price of tracks in the catalog in USD.",
        "valid": true
      },
      {
        "name": "Total Number of Albums",
        "table": "album",
        "expression": "COUNT(DISTINCT \"AlbumId\")",
        "description": "Total number of albums in the catalog.",
        "valid": true
      },
      {
        "name": "Total Number of Artists",
        "table": "artist",
        "expression": "COUNT(DISTINCT \"ArtistId\")",
        "description": "Total number of artists in the catalog.",
        "valid": true
      },
      {
        "name": "Total Number of Employees",
        "table": "employee",
        "expression": "COUNT(DISTINCT \"EmployeeId\")",
        "description": "Total number of employees.",
        "valid": true
      },
      {
        "name": "Total Number of Playlists",
        "table": "playlist",
        "expression": "COUNT(DISTINCT \"PlaylistId\")",
        "description": "Total number of playlists.",
        "valid": true
      }
    ],
    "synonyms": [
      {
        "term": "sales",
        "maps_to": "invoice.Total"
      },
      {
        "term": "customers",
        "maps_to": "customer.CustomerId"
      },
      {
        "term": "tracks sold",
        "maps_to": "invoiceline.InvoiceLineId"
      },
      {
        "term": "albums",
        "maps_to": "album.AlbumId"
      },
      {
        "term": "artists",
        "maps_to": "artist.ArtistId"
      },
      {
        "term": "employees",
        "maps_to": "employee.EmployeeId"
      },
      {
        "term": "playlists",
        "maps_to": "playlist.PlaylistId"
      },
      {
        "term": "track price",
        "maps_to": "track.UnitPrice"
      }
    ],
    "caveats": [
      "Invoice.Total is in USD and represents the total charged per invoice, which may include multiple tracks; summing invoice totals gives total revenue without double counting.",
      "InvoiceLine.Quantity is always 1, so counting invoice lines equals number of tracks sold.",
      "Some columns like customer.State and customer.Company have high null percentages and should be handled accordingly.",
      "Employee.ReportsTo is a self-referential foreign key indicating management hierarchy; some employees may have null managers.",
      "Dates in invoice.InvoiceDate range from 2009 to 2013; analyses involving time should consider this range.",
      "Joins between tables like track to album to artist are many-to-one, but joins involving playlisttrack to track can fan out and increase row counts significantly."
    ],
    "example_questions": [
      "What is the total revenue generated from sales?",
      "How many unique customers have made purchases?",
