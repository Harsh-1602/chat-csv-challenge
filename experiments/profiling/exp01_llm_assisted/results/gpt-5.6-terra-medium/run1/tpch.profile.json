  "semantic_model": {
    "dataset_summary": "This is a TPC-H-style commerce and supply-chain dataset covering customers, orders, order line items, parts, suppliers, and supplier-part availability, with geography modeled through nations and regions. Orders link customers to line items; line items link to ordered parts and fulfilling suppliers. Parts and suppliers are also related through the partsupp availability table, while customers and suppliers roll up to nations and regions.",
    "metrics": [
      {
        "name": "Order Count",
        "table": "orders",
        "expression": "COUNT(*)",
        "description": "Number of orders.",
        "valid": true
      },
      {
        "name": "Order Total Value",
        "table": "orders",
        "expression": "SUM(o_totalprice)",
        "description": "Sum of recorded order total prices.",
        "valid": true
      },
      {
        "name": "Average Order Value",
        "table": "orders",
        "expression": "AVG(o_totalprice)",
        "description": "Average recorded total price per order.",
        "valid": true
      },
      {
        "name": "Customer Count",
        "table": "customer",
        "expression": "COUNT(*)",
        "description": "Number of customers.",
        "valid": true
      },
      {
        "name": "Line Item Count",
        "table": "lineitem",
        "expression": "COUNT(*)",
        "description": "Number of order line items.",
        "valid": true
      },
      {
        "name": "Units Ordered",
        "table": "lineitem",
        "expression": "SUM(l_quantity)",
        "description": "Total quantity across order lines.",
        "valid": true
      },
      {
        "name": "Gross Merchandise Value",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice)",
        "description": "Line-item value before discounts and taxes.",
        "valid": true
      },
      {
        "name": "Discount Amount",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * l_discount)",
        "description": "Total monetary discount applied to line items.",
        "valid": true
      },
      {
        "name": "Net Line Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount))",
        "description": "Line-item revenue after discount and before tax.",
        "valid": true
      },
      {
        "name": "Total Charged Line Value",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax))",
        "description": "Line-item value after discount and tax.",
        "valid": true
      }
    ],
