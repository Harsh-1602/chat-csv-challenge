  "semantic_model": {
    "dataset_summary": "This dataset contains 100 customers, 99 orders placed from 2018-01-01 through 2018-04-09, and 113 payment transactions. Orders link to customers through raw_orders.user_id, and payments link to orders through raw_payments.order_id; an order may have multiple payment records.",
    "metrics": [
      {
        "name": "customer_count",
        "table": "raw_customers",
        "expression": "COUNT(DISTINCT id)",
        "description": "Number of unique customer records.",
        "valid": true
      },
      {
        "name": "order_count",
        "table": "raw_orders",
        "expression": "COUNT(DISTINCT id)",
        "description": "Number of unique orders.",
        "valid": true
      },
      {
        "name": "ordering_customer_count",
        "table": "raw_orders",
        "expression": "COUNT(DISTINCT user_id)",
        "description": "Number of distinct customers who placed at least one order.",
        "valid": true
      },
      {
        "name": "payment_transaction_count",
        "table": "raw_payments",
        "expression": "COUNT(DISTINCT id)",
        "description": "Number of payment transactions.",
        "valid": true
      },
      {
        "name": "payment_amount_dollars",
        "table": "raw_payments",
        "expression": "SUM(amount) / 100.0",
        "description": "Total payment amount in dollars.",
        "valid": true
      },
      {
        "name": "average_payment_dollars",
        "table": "raw_payments",
        "expression": "AVG(amount) / 100.0",
        "description": "Average payment transaction amount in dollars.",
        "valid": true
      },
      {
        "name": "average_payments_per_order",
        "table": "raw_payments",
        "expression": "COUNT(DISTINCT id) * 1.0 / COUNT(DISTINCT order_id)",
        "description": "Average number of payment transactions per order with a payment.",
        "valid": true
      },
      {
        "name": "orders_per_ordering_customer",
        "table": "raw_orders",
        "expression": "COUNT(DISTINCT id) * 1.0 / COUNT(DISTINCT user_id)",
        "description": "Average orders per customer who placed an order.",
        "valid": true
      }
    ],
