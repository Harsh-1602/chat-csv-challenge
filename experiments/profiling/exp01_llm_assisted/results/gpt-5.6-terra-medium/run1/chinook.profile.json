  "semantic_model": {
    "dataset_summary": "This is a digital music store dataset covering the catalog (artists, albums, tracks, genres, media types), customer accounts and support representatives, invoices and purchased track line items, and playlist membership. Sales flow from customer to invoice to invoice line to track; catalog attribution flows from track to album to artist and from track to genre/media type, while playlists connect to tracks through the playlisttrack bridge.",
    "metrics": [
      {
        "name": "Invoice Revenue",
        "table": "invoice",
        "expression": "SUM(\"Total\")",
        "description": "Total billed invoice revenue in USD.",
        "valid": true
      },
      {
        "name": "Invoice Count",
        "table": "invoice",
        "expression": "COUNT(\"InvoiceId\")",
        "description": "Number of customer invoices issued.",
        "valid": true
      },
      {
        "name": "Average Invoice Value",
        "table": "invoice",
        "expression": "AVG(\"Total\")",
        "description": "Average billed amount per invoice in USD.",
        "valid": true
      },
      {
        "name": "Distinct Purchasing Customers",
        "table": "invoice",
        "expression": "COUNT(DISTINCT \"CustomerId\")",
        "description": "Number of customers with at least one invoice.",
        "valid": true
      },
      {
        "name": "Units Sold",
        "table": "invoiceline",
        "expression": "SUM(\"Quantity\")",
        "description": "Total track units purchased across invoice lines.",
        "valid": true
      },
      {
        "name": "Line-item Revenue",
        "table": "invoiceline",
        "expression": "SUM(\"UnitPrice\" * \"Quantity\")",
        "description": "Revenue calculated from invoice-line prices and quantities, in USD.",
        "valid": true
      },
      {
        "name": "Tracks Sold",
        "table": "invoiceline",
        "expression": "COUNT(DISTINCT \"TrackId\")",
        "description": "Number of distinct catalog tracks purchased.",
        "valid": true
      },
      {
        "name": "Catalog Track Count",
        "table": "track",
        "expression": "COUNT(\"TrackId\")",
        "description": "Number of tracks in the catalog.",
        "valid": true
      },
      {
        "name": "Catalog Duration Hours",
        "table": "track",
        "expression": "SUM(\"Milliseconds\") / 3600000.0",
        "description": "Total catalog playback duration in hours.",
        "valid": true
      },
      {
        "name": "Average Track Price",
        "table": "track",
        "expression": "AVG(\"UnitPrice\")",
        "description": "Average catalog list price per track in USD.",
        "valid": true
      }
    ],
    "synonyms": [
      {
        "term": "revenue",
        "maps_to": "Invoice Revenue"
      },
      {
        "term": "sales",
        "maps_to": "Invoice Revenue"
      },
      {
        "term": "billed sales",
        "maps_to": "Invoice Revenue"
      },
      {
        "term": "invoice total",
        "maps_to": "invoice.Total"
      },
      {
        "term": "orders",
        "maps_to": "invoice"
      },
      {
        "term": "purchases",
        "maps_to": "invoiceline"
      },
      {
        "term": "units sold",
        "maps_to": "Units Sold"
      },
      {
        "term": "tracks sold",
        "maps_to": "Tracks Sold"
      },
      {
        "term": "customers",
        "maps_to": "customer"
      },
      {
        "term": "buyers",
        "maps_to": "customer"
      },
      {
        "term": "purchase date",
        "maps_to": "invoice.InvoiceDate"
      },
      {
        "term": "billing country",
        "maps_to": "invoice.BillingCountry"
      },
      {
        "term": "customer country",
