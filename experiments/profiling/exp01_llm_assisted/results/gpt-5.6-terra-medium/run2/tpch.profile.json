  "semantic_model": {
    "dataset_summary": "This is a purchasing and order-fulfillment dataset covering customers, orders, order line items, parts, suppliers, supplier part offerings, and geographic nation/region dimensions. Orders link customers to their line items; line items link to parts and suppliers, while partsupp records each supplier's offered inventory and unit cost for a part. Customers and suppliers each roll up through nation to region.",
    "metrics": [
      {
        "name": "Order Count",
        "table": "orders",
        "expression": "COUNT(*)",
        "description": "Number of orders.",
        "valid": true
      },
      {
        "name": "Total Order Value",
        "table": "orders",
        "expression": "SUM(o_totalprice)",
        "description": "Sum of recorded order total prices.",
        "valid": true
      },
      {
        "name": "Average Order Value",
        "table": "orders",
        "expression": "AVG(o_totalprice)",
        "description": "Average recorded total price per order.",
        "valid": true
      },
      {
        "name": "Line Item Count",
        "table": "lineitem",
        "expression": "COUNT(*)",
        "description": "Number of order line items.",
        "valid": true
      },
      {
        "name": "Units Ordered",
        "table": "lineitem",
        "expression": "SUM(l_quantity)",
        "description": "Total quantity ordered across line items.",
        "valid": true
      },
      {
        "name": "Gross Merchandise Value",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice)",
        "description": "Pre-discount extended value of ordered line items.",
        "valid": true
      },
      {
        "name": "Discount Amount",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * l_discount)",
        "description": "Monetary discount applied to line items.",
        "valid": true
      },
      {
        "name": "Net Line Item Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount))",
        "description": "Extended value after discount and before tax.",
        "valid": true
      },
      {
        "name": "Tax-Inclusive Line Item Value",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax))",
        "description": "Discounted line-item value including tax.",
        "valid": true
      },
      {
        "name": "Available Inventory Units",
        "table": "partsupp",
        "expression": "SUM(ps_availqty)",
        "description": "Total available units across all part-supplier offerings.",
        "valid": true
      }
    ],
