  "semantic_model": {
    "dataset_summary": "This is a transactional sales and supply-chain dataset covering customers, orders, order line items, parts, suppliers, and part\u2013supplier inventory/cost relationships, with nation and region geography. Orders belong to customers and contain multiple line items; each line item references a part and fulfilling supplier. Customers and suppliers map to nations, which map to regions; parts and suppliers have a many-to-many relationship through partsupp.",
    "metrics": [
      {
        "name": "Order Count",
        "table": "orders",
        "expression": "COUNT(DISTINCT o_orderkey)",
        "description": "Number of unique orders.",
        "valid": true
      },
      {
        "name": "Order Revenue",
        "table": "orders",
        "expression": "SUM(o_totalprice)",
        "description": "Sum of order-level total prices.",
        "valid": true
      },
      {
        "name": "Average Order Value",
        "table": "orders",
        "expression": "AVG(o_totalprice)",
        "description": "Average total price per order.",
        "valid": true
      },
      {
        "name": "Line Item Count",
        "table": "lineitem",
        "expression": "COUNT(*)",
        "description": "Number of order line items.",
        "valid": true
      },
      {
        "name": "Units Ordered",
        "table": "lineitem",
        "expression": "SUM(l_quantity)",
        "description": "Total quantity ordered across line items.",
        "valid": true
      },
      {
        "name": "Gross Line Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice)",
        "description": "Line-item revenue before discounts and tax.",
        "valid": true
      },
      {
        "name": "Discount Amount",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * l_discount)",
        "description": "Total monetary discount granted on line items.",
        "valid": true
      },
      {
        "name": "Net Line Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount))",
        "description": "Revenue after discount and before tax.",
        "valid": true
      },
      {
        "name": "Tax-Inclusive Line Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax))",
        "description": "Discounted line-item revenue including tax.",
        "valid": true
      },
      {
        "name": "Available Inventory Units",
        "table": "partsupp",
        "expression": "SUM(ps_availqty)",
        "description": "Total currently available supplier inventory units.",
        "valid": true
      }
    ],
