  "semantic_model": {
    "dataset_summary": "This dataset covers customers, their orders, and payment transactions. `raw_orders` links each order to one customer through `user_id`, while `raw_payments` links payment transactions to orders through `order_id`; an order can have multiple payments.",
    "metrics": [
      {
        "name": "Customer Count",
        "table": "raw_customers",
        "expression": "COUNT(DISTINCT id)",
        "description": "Number of unique customers.",
        "valid": true
      },
      {
        "name": "Order Count",
        "table": "raw_orders",
        "expression": "COUNT(DISTINCT id)",
        "description": "Number of unique orders placed.",
        "valid": true
      },
      {
        "name": "Ordering Customer Count",
        "table": "raw_orders",
        "expression": "COUNT(DISTINCT user_id)",
        "description": "Number of distinct customers with at least one order.",
        "valid": true
      },
      {
        "name": "Payment Transaction Count",
        "table": "raw_payments",
        "expression": "COUNT(DISTINCT id)",
        "description": "Number of payment transactions.",
        "valid": true
      },
      {
        "name": "Total Payment Amount",
        "table": "raw_payments",
        "expression": "SUM(amount) / 100.0",
        "description": "Total payment amount in dollars.",
        "valid": true
      },
      {
        "name": "Average Payment Amount",
        "table": "raw_payments",
        "expression": "AVG(amount) / 100.0",
        "description": "Average payment transaction amount in dollars.",
        "valid": true
      },
      {
        "name": "Paid Order Count",
        "table": "raw_payments",
        "expression": "COUNT(DISTINCT order_id)",
        "description": "Number of distinct orders with at least one payment record.",
        "valid": true
      },
      {
        "name": "Average Payments per Paid Order",
        "table": "raw_payments",
        "expression": "COUNT(*) * 1.0 / COUNT(DISTINCT order_id)",
        "description": "Average number of payment transactions for orders that have payments.",
        "valid": true
      }
    ],
