  "semantic_model": {
    "dataset_summary": "This music-store dataset covers the catalog (artists, albums, tracks, genres, media types), customer accounts and support representatives, invoices and purchased track line items, plus playlist membership. Sales flow from customer to invoice to invoiceline; each invoice line references a catalog track, which rolls up to album and artist and is classified by genre and media type. Playlisttrack is a many-to-many bridge between playlists and tracks.",
    "metrics": [
      {
        "name": "Invoice Revenue",
        "table": "invoice",
        "expression": "SUM(\"Total\")",
        "description": "Total invoiced revenue in USD.",
        "valid": true
      },
      {
        "name": "Invoice Count",
        "table": "invoice",
        "expression": "COUNT(DISTINCT \"InvoiceId\")",
        "description": "Number of issued invoices.",
        "valid": true
      },
      {
        "name": "Average Invoice Value",
        "table": "invoice",
        "expression": "AVG(\"Total\")",
        "description": "Average invoice total in USD.",
        "valid": true
      },
      {
        "name": "Paying Customers",
        "table": "invoice",
        "expression": "COUNT(DISTINCT \"CustomerId\")",
        "description": "Number of distinct customers with at least one invoice.",
        "valid": true
      },
      {
        "name": "Units Sold",
        "table": "invoiceline",
        "expression": "SUM(\"Quantity\")",
        "description": "Total track units purchased.",
        "valid": true
      },
      {
        "name": "Line Item Revenue",
        "table": "invoiceline",
        "expression": "SUM(\"UnitPrice\" * \"Quantity\")",
        "description": "Revenue calculated from invoice-line prices and quantities, in USD.",
        "valid": true
      },
      {
        "name": "Tracks Sold",
        "table": "invoiceline",
        "expression": "COUNT(DISTINCT \"TrackId\")",
        "description": "Number of distinct catalog tracks purchased.",
        "valid": true
      },
      {
        "name": "Catalog Tracks",
        "table": "track",
        "expression": "COUNT(DISTINCT \"TrackId\")",
        "description": "Number of tracks in the catalog.",
        "valid": true
      },
      {
        "name": "Average Track Duration (Minutes)",
        "table": "track",
        "expression": "AVG(\"Milliseconds\") / 60000.0",
        "description": "Average catalog track playback duration in minutes.",
        "valid": true
      },
      {
        "name": "Playlist Track Memberships",
        "table": "playlisttrack",
        "expression": "COUNT(*)",
        "description": "Total track-to-playlist memberships.",
        "valid": true
      }
    ],
    "synonyms": [
      {
        "term": "revenue",
        "maps_to": "Invoice Revenue"
      },
      {
        "term": "sales",
        "maps_to": "Invoice Revenue"
      },
      {
        "term": "invoice total",
        "maps_to": "invoice.Total"
      },
      {
        "term": "orders",
        "maps_to": "invoice"
      },
      {
        "term": "purchases",
        "maps_to": "invoice / invoiceline"
      },
      {
        "term": "average order value",
        "maps_to": "Average Invoice Value"
      },
      {
        "term": "AOV",
        "maps_to": "Average Invoice Value"
      },
      {
        "term": "customers",
        "maps_to": "customer"
      },
      {
        "term": "buyers",
        "maps_to": "invoice.CustomerId"
      },
      {
        "term": "units sold",
        "maps_to": "Units Sold"
      },
      {
        "term": "tracks sold",
        "maps_to": "Tracks Sold"
      },
      {
        "term": "song",
