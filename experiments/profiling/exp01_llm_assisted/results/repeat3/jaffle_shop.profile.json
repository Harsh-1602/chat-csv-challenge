  "semantic_model": {
    "dataset_summary": "This dataset contains information about customers, their orders, and payments related to those orders. The raw_customers table holds customer details, raw_orders records each order placed by customers, and raw_payments tracks payments made for orders. The tables are connected via user_id linking orders to customers and order_id linking payments to orders.",
    "metrics": [
      {
        "name": "Total Customers",
        "table": "raw_customers",
        "expression": "COUNT(DISTINCT id)",
        "description": "Total number of unique customers.",
        "valid": true
      },
      {
        "name": "Total Orders",
        "table": "raw_orders",
        "expression": "COUNT(id)",
        "description": "Total number of orders placed.",
        "valid": true
      },
      {
        "name": "Total Payments",
        "table": "raw_payments",
        "expression": "COUNT(id)",
        "description": "Total number of payment records.",
        "valid": true
      },
      {
        "name": "Total Payment Amount",
        "table": "raw_payments",
        "expression": "SUM(amount)",
        "description": "Total amount paid across all payments.",
        "valid": true
      },
      {
        "name": "Average Payment Amount",
        "table": "raw_payments",
        "expression": "AVG(amount)",
        "description": "Average amount paid per payment.",
        "valid": true
      },
      {
        "name": "Orders with Payments",
        "table": "raw_orders",
        "expression": "COUNT(DISTINCT id)",
        "description": "Number of orders that have at least one payment.",
        "valid": true
      }
    ],
    "synonyms": [
      {
        "term": "customer",
        "maps_to": "raw_customers"
      },
      {
        "term": "user",
        "maps_to": "raw_customers.id"
      },
      {
        "term": "order",
        "maps_to": "raw_orders"
      },
      {
        "term": "purchase",
        "maps_to": "raw_orders"
      },
      {
        "term": "payment",
        "maps_to": "raw_payments"
      },
      {
        "term": "amount paid",
        "maps_to": "raw_payments.amount"
      },
      {
        "term": "payment method",
        "maps_to": "raw_payments.payment_method"
      },
      {
        "term": "order status",
        "maps_to": "raw_orders.status"
      }
    ],
    "caveats": [
      "The amount column in raw_payments is in currency units with no decimals, ensure correct interpretation of units.",
      "Some orders may have multiple payments, so joining raw_orders to raw_payments can cause fan-out and double counting if aggregations are not handled carefully.",
      "Not all customers may have placed orders, and not all orders may have payments recorded.",
      "Dates in raw_orders.order_date range from 2018-01-01 to 2018-04-09, so analysis outside this range is not possible.",
      "Nullable keys are not explicitly indicated but ensure joins handle missing references gracefully."
    ],
    "example_questions": [
      "How many customers placed orders in the first quarter of 2018?",
      "What is the total payment amount received by payment method?",
      "Which customers have placed the most orders?",
      "What is the average payment amount per order status?",
      "How many orders have not received any payments yet?"
    ]
  },
