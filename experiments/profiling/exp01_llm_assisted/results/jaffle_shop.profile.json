      },
      {
        "term": "number of payments",
        "maps_to": "Total Payments"
      },
      {
        "term": "revenue",
        "maps_to": "Total Revenue"
      },
      {
        "term": "sales",
        "maps_to": "Total Revenue"
      },
      {
        "term": "average payment",
        "maps_to": "Average Payment Amount"
      },
      {
        "term": "average order per customer",
        "maps_to": "Average Orders per Customer"
      },
      {
        "term": "payment method",
        "maps_to": "raw_payments.payment_method"
      },
      {
        "term": "order status",
        "maps_to": "raw_orders.status"
      }
    ],
    "caveats": [
      "Payment amounts are stored in cents and converted to dollars in metrics; be mindful of unit conversions.",
      "Orders may have multiple payments, so joining orders to payments can cause fan-out and double counting if aggregations are not handled carefully.",
      "Some customers may not have placed any orders, and some orders may not have payments recorded yet.",
      "Date range for orders is from 2018-01-01 to 2018-04-09; payments are linked to these orders.",
      "Order status is a categorical field and may have multiple values representing different stages."
    ],
    "example_questions": [
      "How many customers placed orders between January and March 2018?",
      "What is the total revenue generated from all payments?",
      "What is the average number of orders per customer?",
      "Which payment methods are most commonly used?",
      "How many orders have the status 'completed'?"
    ]
