  "semantic_model": {
    "dataset_summary": "This dataset contains information about customers, their orders, and associated payment transactions. The raw_customers table holds customer details, raw_orders records each order placed by customers, and raw_payments tracks payment transactions linked to orders. The tables are connected via user_id linking orders to customers and order_id linking payments to orders.",
    "metrics": [
      {
        "name": "Total Customers",
        "table": "raw_customers",
        "expression": "COUNT(DISTINCT id)",
        "description": "Total number of unique customers.",
        "valid": true
      },
      {
        "name": "Total Orders",
        "table": "raw_orders",
        "expression": "COUNT(id)",
        "description": "Total number of orders placed.",
        "valid": true
      },
      {
        "name": "Total Payments",
        "table": "raw_payments",
        "expression": "COUNT(id)",
        "description": "Total number of payment transactions.",
        "valid": true
      },
      {
        "name": "Total Revenue",
        "table": "raw_payments",
        "expression": "SUM(amount) / 100.0",
        "description": "Total revenue from all payments in dollars.",
        "valid": true
      },
      {
        "name": "Average Payment Amount",
        "table": "raw_payments",
        "expression": "AVG(amount) / 100.0",
        "description": "Average payment amount per transaction in dollars.",
        "valid": true
      },
      {
        "name": "Average Orders per Customer",
        "table": "raw_orders",
        "expression": "COUNT(id) * 1.0 / COUNT(DISTINCT user_id)",
        "description": "Average number of orders placed per customer.",
        "valid": true
      }
    ],
    "synonyms": [
      {
        "term": "customer count",
        "maps_to": "Total Customers"
      },
      {
        "term": "number of customers",
        "maps_to": "Total Customers"
      },
      {
