  "semantic_model": {
    "dataset_summary": "This dataset contains information about customers, their orders, and associated payment transactions. The raw_customers table holds customer details, raw_orders records each order placed by customers, and raw_payments tracks payment transactions linked to orders. The tables connect via raw_orders.user_id to raw_customers.id and raw_payments.order_id to raw_orders.id.",
    "metrics": [
      {
        "name": "Total Customers",
        "table": "raw_customers",
        "expression": "COUNT(DISTINCT id)",
        "description": "Total number of unique customers.",
        "valid": true
      },
      {
        "name": "Total Orders",
        "table": "raw_orders",
        "expression": "COUNT(id)",
        "description": "Total number of orders placed.",
        "valid": true
      },
      {
        "name": "Total Payments",
        "table": "raw_payments",
        "expression": "COUNT(id)",
        "description": "Total number of payment transactions.",
        "valid": true
      },
      {
        "name": "Total Payment Amount",
        "table": "raw_payments",
        "expression": "SUM(amount)",
        "description": "Total amount paid across all payment transactions.",
        "valid": true
      },
      {
        "name": "Average Payment Amount",
        "table": "raw_payments",
        "expression": "AVG(amount)",
        "description": "Average amount paid per payment transaction.",
        "valid": true
      },
      {
        "name": "Distinct Payment Methods",
        "table": "raw_payments",
        "expression": "COUNT(DISTINCT payment_method)",
        "description": "Number of distinct payment methods used.",
        "valid": true
      }
    ],
    "synonyms": [
      {
        "term": "customer",
        "maps_to": "raw_customers"
      },
      {
        "term": "user",
        "maps_to": "raw_customers"
      },
      {
        "term": "order",
        "maps_to": "raw_orders"
      },
      {
        "term": "purchase",
        "maps_to": "raw_orders"
      },
      {
        "term": "payment",
        "maps_to": "raw_payments"
      },
      {
        "term": "transaction",
        "maps_to": "raw_payments"
      },
      {
        "term": "payment amount",
        "maps_to": "Total Payment Amount"
      },
      {
        "term": "number of customers",
        "maps_to": "Total Customers"
      },
      {
        "term": "number of orders",
        "maps_to": "Total Orders"
      },
      {
        "term": "payment methods",
        "maps_to": "Distinct Payment Methods"
      }
    ],
    "caveats": [
      "The amount column in raw_payments is in currency units with no subunit conversion needed.",
      "Orders may have multiple payments, so joining raw_orders to raw_payments can cause fan-out and potential double counting if aggregations are not handled carefully.",
      "Not all customers may have placed orders, and not all orders may have associated payments.",
      "Order dates range from 2018-01-01 to 2018-04-09; analyses outside this range are not supported.",
      "Some orders may have multiple payment transactions, so summing payments by order requires caution to avoid double counting."
    ],
    "example_questions": [
      "How many customers placed orders between January and March 2018?",
      "What is the total payment amount received by payment method?",
      "Which customers have placed the most orders?",
      "What is the average payment amount per order?",
      "How many distinct payment methods are used in the dataset?"
    ]
