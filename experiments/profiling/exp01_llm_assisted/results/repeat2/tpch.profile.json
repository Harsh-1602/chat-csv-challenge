        "maps_to": "nation.n_name"
      },
      {
        "term": "order date",
        "maps_to": "orders.o_orderdate"
      },
      {
        "term": "shipping mode",
        "maps_to": "lineitem.l_shipmode"
      },
      {
        "term": "discount",
        "maps_to": "lineitem.l_discount"
      }
