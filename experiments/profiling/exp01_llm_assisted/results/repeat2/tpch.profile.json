  "semantic_model": {
    "dataset_summary": "This dataset covers a retail order system with tables for customers, orders, line items, parts, suppliers, nations, and regions. Customers place orders, which contain multiple line items referencing parts supplied by suppliers. Nations and regions provide geographic context for customers and suppliers.",
    "metrics": [
      {
        "name": "Total Customers",
        "table": "customer",
        "expression": "COUNT(DISTINCT c_custkey)",
        "description": "Total number of unique customers.",
        "valid": true
      },
      {
        "name": "Total Orders",
        "table": "orders",
        "expression": "COUNT(DISTINCT o_orderkey)",
        "description": "Total number of unique orders placed.",
        "valid": true
      },
      {
        "name": "Total Revenue",
        "table": "lineitem",
        "expression": "SUM(l_extendedprice * (1 - l_discount))",
        "description": "Total revenue from all line items after discounts.",
        "valid": true
      },
      {
        "name": "Average Order Price",
        "table": "orders",
        "expression": "AVG(o_totalprice)",
        "description": "Average total price of orders.",
        "valid": true
      },
      {
        "name": "Total Quantity Ordered",
        "table": "lineitem",
        "expression": "SUM(l_quantity)",
        "description": "Total quantity of parts ordered across all line items.",
        "valid": true
      },
      {
        "name": "Average Customer Account Balance",
        "table": "customer",
        "expression": "AVG(c_acctbal)",
        "description": "Average account balance of customers in USD.",
        "valid": true
      },
      {
        "name": "Total Suppliers",
        "table": "supplier",
        "expression": "COUNT(DISTINCT s_suppkey)",
        "description": "Total number of unique suppliers.",
        "valid": true
      },
      {
        "name": "Average Supply Cost",
        "table": "partsupp",
        "expression": "AVG(ps_supplycost)",
        "description": "Average cost to supply one unit of parts from suppliers.",
        "valid": true
      }
    ],
    "synonyms": [
      {
        "term": "clients",
        "maps_to": "customer.c_custkey"
      },
      {
        "term": "orders",
        "maps_to": "orders.o_orderkey"
      },
      {
        "term": "sales revenue",
        "maps_to": "Total Revenue"
      },
